# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local Codex workspace configuration
/.codex/

# typescript
*.tsbuildinfo
next-env.d.ts

# rembg local venv (background removal pipeline)
/.venv-rembg/

# caché local del pipeline de imágenes
/.image-cache/

# datos y herramientas locales del pipeline de catálogo — no se versionan:
# exports/ e imports/ son datos (xlsx, imágenes de productos) y los scripts
# son tooling de un solo uso que se corre a mano
/exports/
/imports/
/scripts/lib/
/scripts/export-products-xlsx.mjs
/scripts/import-aruma-skin.mjs
/scripts/product-images-*.mjs
/scripts/product-images-progress.json

# informe generado del rediseño del quiz (se regenera con build-report.mjs)
/scripts/quiz-redesign/quiz-v2.html
